{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nabhold.com/baobab/events/envelope/v1",
  "title": "Baobab Event Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "source",
    "correlation_id",
    "tenant_id",
    "entity_id",
    "payload"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1, "maxLength": 140},
    "event_type": {"type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+)+$"},
    "schema_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+$"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "source": {"enum": ["baobab-trade", "baobab-erp", "baobab-pulse"]},
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 140},
    "causation_id": {"type": ["string", "null"], "maxLength": 140},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 140},
    "entity_id": {"type": "string", "minLength": 1, "maxLength": 140},
    "payload": {"type": "object"}
  }
}
