<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.nabhold.baobab.erp</groupId>
    <artifactId>baobab-erp-extensions</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>org.nabhold.baobab.erp.context</artifactId>
  <packaging>jar</packaging>

  <name>Baobab ERP Context Bundle</name>
  <description>
    Resolves the inbound Baobab Context (tenant, legal entity, correlation) into the
    iDempiere AD_Client/AD_Org pair for the current request, per ADR-ERP-002 and
    ADR-ERP-010. Fails closed on missing or ambiguous mapping.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.nabhold.baobab.erp</groupId>
      <artifactId>org.nabhold.baobab.erp.integration</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
        <configuration>
          <bnd><![CDATA[
Bundle-SymbolicName: org.nabhold.baobab.erp.context
Bundle-Activator: org.nabhold.baobab.erp.context.ContextActivator
Bundle-Vendor: Nabhold Group Africa
Export-Package: org.nabhold.baobab.erp.context
Import-Package: org.nabhold.baobab.erp.integration;version="[0.1,1)",*
]]></bnd>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
